// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "adapter": "Delve",
    "label": "go test ./disktools -bench GetGPTHeader",
    "request": "launch",
    "mode": "test",
    "program": ".",
    "cwd": "$ZED_DIRNAME",
    "args": [
      "-test.benchmem",
      "-test.run='^$'",
      "-test.bench",
      "^$ZED_SYMBOL$",
      "-test.v"
    ],
    "buildFlags": [],
    "env": {}
  },
  {
    "adapter": "Delve",
    "label": "go run ./disktools",
    "request": "launch",
    "mode": "debug",
    "program": ".",
    "cwd": "$ZED_DIRNAME",
    "args": [],
    "buildFlags": [],
    "env": {}
  },
  {
    "label": "Launch main as root",
    "adapter": "Delve",
    "request": "launch",
    "mode": "exec",
    "program": "$ZED_WORKTREE_ROOT/main",
    "cwd": "$ZED_WORKTREE_ROOT",
    "tcp_connection": { "host": "127.0.0.1", "port": 2345 }
  },
  {
    "label": "Attach to running main (root)",
    "adapter": "Delve",
    "request": "attach",
    "mode": "local",
    "processId": 12831,
    "tcp_connection": { "host": "127.0.0.1", "port": 2345 }
  }
]
